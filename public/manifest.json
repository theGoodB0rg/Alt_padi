{
  "manifest_version": 3,
  "name": "AltPadi",
  "short_name": "AltPadi",
  "version": "0.1.0",
  "description": "Find cheaper Jumia alternatives in Nigeria using price, brand, specs, ratings, and review signals.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://www.jumia.com.ng/*"
  ],
  "action": {
    "default_title": "AltPadi: Cheaper Jumia Alternatives",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.jumia.com.ng/*"
      ],
      "js": [
        "assets/content.js"
      ]
    }
  ]
}
